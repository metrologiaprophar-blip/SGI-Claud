// Fuente de verdad del modelo de datos. Proveedor de producción: PostgreSQL.
// Para desarrollo con SQLite, `npm run db:generate` crea prisma/generated/sqlite/schema.prisma
// cambiando solo el proveedor. No usar tipos nativos @db.* ni arrays escalares.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN_EMPRESA
  USUARIO
}

enum Status {
  ACTIVE
  SUSPENDED
}

enum ResetStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

/// Tipos de documento controlado (PRD §8, área Documentos).
enum DocumentType {
  MANUAL
  POLICY
  SOP
  INSTRUCTION
  SPECIFICATION
  FORM
  PLAN
  OTHER
}

enum DocumentStatus {
  ACTIVE
  OBSOLETE
}

/// Ciclo de vida de una versión: DRAFT → IN_REVIEW → PENDING_APPROVAL → APPROVED/EFFECTIVE → SUPERSEDED/OBSOLETE.
enum VersionStatus {
  DRAFT
  IN_REVIEW
  PENDING_APPROVAL
  APPROVED
  EFFECTIVE
  SUPERSEDED
  OBSOLETE
  CANCELLED
}

/// Significado de una firma electrónica (21 CFR 11.50 / EU GMP Anexo 11).
enum SignatureMeaning {
  AUTHORED
  REVIEWED
  APPROVED
  REJECTED
  READ
  OBSOLETED
  VERIFIED
}

enum Classification {
  MINOR
  MAJOR
  CRITICAL
}

enum DeviationStatus {
  REPORTED
  UNDER_INVESTIGATION
  PENDING_QA
  CLOSED
  CANCELLED
}

enum DeviationCategory {
  PROCESS
  EQUIPMENT
  MATERIAL
  DOCUMENTATION
  ENVIRONMENT
  PERSONNEL
  STORAGE_TRANSPORT
  LABORATORY
  COMPUTERIZED_SYSTEM
  OTHER
}

enum RootCauseMethod {
  FIVE_WHYS
  ISHIKAWA
  FAULT_TREE
  OTHER
}

enum CapaStatus {
  OPEN
  IN_PROGRESS
  EFFECTIVENESS_CHECK
  CLOSED
  CANCELLED
}

enum CapaSource {
  DEVIATION
  AUDIT
  COMPLAINT
  CHANGE_CONTROL
  MANAGEMENT_REVIEW
  RISK
  OOS
  INSPECTION
  PROFICIENCY
  OTHER
}

enum CapaType {
  CORRECTIVE
  PREVENTIVE
  BOTH
}

enum ChangeStatus {
  DRAFT
  IN_ASSESSMENT
  APPROVED
  IMPLEMENTED
  CLOSED
  REJECTED
  CANCELLED
}

enum ChangeType {
  PROCESS
  EQUIPMENT
  FACILITY
  DOCUMENT
  SUPPLIER
  MATERIAL
  COMPUTERIZED_SYSTEM
  ANALYTICAL_METHOD
  PRODUCT
  STORAGE_DISTRIBUTION
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ActionStatus {
  PENDING
  DONE
  CANCELLED
}

enum EquipmentStatus {
  IN_SERVICE
  OUT_OF_SERVICE
  RETIRED
}

enum CalibrationKind {
  INTERNAL
  EXTERNAL
}

enum CalibrationResult {
  CONFORM
  ADJUSTED
  NON_CONFORM
}

enum RecordStatus {
  RECORDED
  APPROVED
  REJECTED
}

enum VerificationResult {
  CONFORM
  NON_CONFORM
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

enum QualificationPhase {
  DQ
  IQ
  OQ
  PQ
}

enum QualificationResult {
  PASS
  FAIL
}

enum ProficiencyOutcome {
  SATISFACTORY
  QUESTIONABLE
  UNSATISFACTORY
}

/// Empresa (tenant). `code` es el "ID corporativo" del login.
model Organization {
  id                 String   @id @default(cuid())
  code               String   @unique
  name               String
  taxId              String?
  status             Status   @default(ACTIVE)
  locale             String   @default("es")
  timezone           String   @default("America/Guayaquil")
  passwordMaxAgeDays Int      @default(90)
  sessionIdleMinutes Int      @default(15)
  isPlatform         Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users         User[]
  resetRequests PasswordResetRequest[]
  auditLogs     AuditLog[]
  processes     Process[]
  documents     Document[]
}

model User {
  id                 String    @id @default(cuid())
  organizationId     String
  username           String
  fullName           String
  email              String?
  jobTitle           String?
  passwordHash       String
  /// Últimos hashes de contraseña (array JSON de strings) para impedir su reutilización.
  passwordHistory    Json?
  /// Permisos GMP (array JSON): DOC_MANAGE (control documental), DOC_APPROVE (aprobar documentos).
  permissions        Json?
  role               Role      @default(USUARIO)
  status             Status    @default(ACTIVE)
  locale             String?
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id])
  resetRequests PasswordResetRequest[]

  ownedDocuments   Document[]        @relation("DocumentOwner")
  authoredVersions DocumentVersion[] @relation("VersionAuthor")
  reviewVersions   DocumentVersion[] @relation("VersionReviewer")
  approveVersions  DocumentVersion[] @relation("VersionApprover")

  reportedDeviations     Deviation[]     @relation("DeviationReporter")
  investigatedDeviations Deviation[]     @relation("DeviationInvestigator")
  ownedCapas             Capa[]          @relation("CapaOwner")
  requestedChanges       ChangeControl[] @relation("ChangeRequester")
  assignedActions        QualityAction[] @relation("ActionResponsible")
  ownedEquipment         Equipment[]     @relation("EquipmentOwner")

  @@unique([organizationId, username])
  @@index([organizationId])
}

model PasswordResetRequest {
  id             String      @id @default(cuid())
  organizationId String
  userId         String
  status         ResetStatus @default(PENDING)
  note           String?
  requestIp      String?
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  expiresAt      DateTime
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, status])
  @@index([userId, status])
}

/// Registro de auditoría GMP. Solo inserción: nunca se actualiza ni se borra.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  actorName      String?
  action         String
  entityType     String?
  entityId       String?
  before         Json?
  after          Json?
  reason         String?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

/// Proceso del mapa de procesos (dueño de documentos, auditorías, indicadores…).
model Process {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id])
  documents      Document[]
  deviations     Deviation[]
  changeControls ChangeControl[]
  equipment      Equipment[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

/// Documento controlado. Sus contenidos viven en DocumentVersion; nunca se borra (se declara obsoleto).
model Document {
  id                 String         @id @default(cuid())
  organizationId     String
  code               String
  title              String
  type               DocumentType
  processId          String
  ownerId            String
  /// Normas a las que aplica (array JSON de códigos: GMP, BPADT, ISO9001…).
  standards          Json
  reviewPeriodMonths Int            @default(24)
  status             DocumentStatus @default(ACTIVE)
  obsoletedAt        DateTime?
  obsoleteReason     String?
  createdById        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  process      Process           @relation(fields: [processId], references: [id])
  owner        User              @relation("DocumentOwner", fields: [ownerId], references: [id])
  versions     DocumentVersion[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
}

/// Versión de un documento. Una vez enviada a revisión su contenido no cambia.
model DocumentVersion {
  id             String        @id @default(cuid())
  organizationId String
  documentId     String
  version        Int
  status         VersionStatus @default(DRAFT)
  changeSummary  String
  authorId       String
  reviewerId     String?
  approverId     String?
  /// Usuarios con lectura obligatoria al entrar en vigencia (array JSON de ids).
  readerIds      Json?
  effectiveDate  DateTime?
  nextReviewDate DateTime?
  fileName       String?
  fileMime       String?
  fileSize       Int?
  fileSha256     String?
  storageKey     String?
  lastRejection  String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  approvedAt     DateTime?
  effectiveAt    DateTime?
  supersededAt   DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  document Document              @relation(fields: [documentId], references: [id])
  author   User                  @relation("VersionAuthor", fields: [authorId], references: [id])
  reviewer User?                 @relation("VersionReviewer", fields: [reviewerId], references: [id])
  approver User?                 @relation("VersionApprover", fields: [approverId], references: [id])
  reads    ReadAcknowledgement[]

  @@unique([documentId, version])
  @@index([organizationId, status])
  @@index([reviewerId, status])
  @@index([approverId, status])
}

/// Firma electrónica. Solo inserción: vincula usuario, significado, fecha y hash del contenido firmado.
model ElectronicSignature {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  userFullName   String
  userJobTitle   String?
  meaning        SignatureMeaning
  entityType     String
  entityId       String
  /// SHA-256 del archivo firmado.
  contentHash    String?
  /// SHA-256 del manifiesto de firma (usuario, significado, fecha, registro y contenido).
  signatureHash  String
  comment        String?
  ip             String?
  signedAt       DateTime         @default(now())

  @@index([organizationId, userId])
  @@index([entityType, entityId])
}

/// Lectura obligatoria de una versión vigente (formación en el documento).
model ReadAcknowledgement {
  id             String    @id @default(cuid())
  organizationId String
  versionId      String
  userId         String
  dueDate        DateTime?
  acknowledgedAt DateTime?
  signatureId    String?
  createdAt      DateTime  @default(now())

  version DocumentVersion @relation(fields: [versionId], references: [id])

  @@unique([versionId, userId])
  @@index([organizationId, userId])
}

/// Desviación GMP/BPADT: detección → clasificación → investigación → cierre por Garantía de Calidad.
model Deviation {
  id                 String            @id @default(cuid())
  organizationId     String
  code               String
  title              String
  description        String
  category           DeviationCategory
  processId          String
  location           String?
  detectedAt         DateTime
  reportedById       String
  batches            String?
  immediateAction    String
  status             DeviationStatus   @default(REPORTED)
  classification     Classification?
  investigatorId     String?
  dueDate            DateTime?
  capaRequired       Boolean           @default(false)
  triageComment      String?
  rootCauseMethod    RootCauseMethod?
  rootCause          String?
  impactAssessment   String?
  productDisposition String?
  conclusion         String?
  returnComment      String?
  closedAt           DateTime?
  closedById         String?
  cancelReason       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  process      Process @relation(fields: [processId], references: [id])
  reportedBy   User    @relation("DeviationReporter", fields: [reportedById], references: [id])
  investigator User?   @relation("DeviationInvestigator", fields: [investigatorId], references: [id])
  capas        Capa[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

/// Acción correctiva/preventiva con plan, seguimiento y verificación de eficacia.
model Capa {
  id                    String     @id @default(cuid())
  organizationId        String
  code                  String
  title                 String
  source                CapaSource
  deviationId           String?
  sourceReference       String?
  problemStatement      String
  rootCause             String?
  type                  CapaType
  ownerId               String
  status                CapaStatus @default(OPEN)
  effectivenessCriteria String
  targetDate            DateTime
  effectivenessDueDate  DateTime?
  effectivenessResult   String?
  returnComment         String?
  verifiedById          String?
  closedAt              DateTime?
  cancelReason          String?
  createdById           String
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  deviation Deviation?      @relation(fields: [deviationId], references: [id])
  owner     User            @relation("CapaOwner", fields: [ownerId], references: [id])
  actions   QualityAction[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

/// Control de cambios: propuesta → evaluación de impacto y riesgo → aprobación → implementación → cierre.
model ChangeControl {
  id                     String          @id @default(cuid())
  organizationId         String
  code                   String
  title                  String
  description            String
  justification          String
  changeType             ChangeType
  processId              String
  affectedItems          String?
  plannedDate            DateTime?
  requesterId            String
  status                 ChangeStatus    @default(DRAFT)
  classification         Classification?
  riskLevel              RiskLevel?
  regulatoryNotification Boolean?
  impactQuality          String?
  impactValidation       String?
  impactDocuments        String?
  impactTraining         String?
  assessmentComment      String?
  approvedById           String?
  approvedAt             DateTime?
  implementedAt          DateTime?
  closureComment         String?
  closedAt               DateTime?
  cancelReason           String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  process   Process         @relation(fields: [processId], references: [id])
  requester User            @relation("ChangeRequester", fields: [requesterId], references: [id])
  actions   QualityAction[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

/// Acción de un plan (CAPA o control de cambios) con responsable, plazo y evidencia.
model QualityAction {
  id              String       @id @default(cuid())
  organizationId  String
  capaId          String?
  changeControlId String?
  description     String
  responsibleId   String
  dueDate         DateTime
  status          ActionStatus @default(PENDING)
  evidence        String?
  completedAt     DateTime?
  completedById   String?
  createdAt       DateTime     @default(now())

  capa          Capa?          @relation(fields: [capaId], references: [id])
  changeControl ChangeControl? @relation(fields: [changeControlId], references: [id])
  responsible   User           @relation("ActionResponsible", fields: [responsibleId], references: [id])

  @@index([organizationId, responsibleId, status])
}

/// Equipo o instrumento de medición. Las fechas de vencimiento se actualizan al aprobar registros.
model Equipment {
  id                        String          @id @default(cuid())
  organizationId            String
  code                      String
  name                      String
  equipmentType             String
  manufacturer              String?
  model                     String?
  serialNumber              String?
  location                  String?
  processId                 String
  ownerId                   String
  criticality               RiskLevel       @default(MEDIUM)
  isReferenceStandard       Boolean         @default(false)
  measurementRange          String?
  resolution                String?
  unit                      String?
  /// Error máximo permitido (EMP) en la unidad del equipo; base de la regla de decisión.
  maxPermissibleError       Float?
  calibrationIntervalMonths Int?
  verificationIntervalDays  Int?
  maintenanceIntervalMonths Int?
  lastCalibrationAt         DateTime?
  nextCalibrationDue        DateTime?
  lastVerificationAt        DateTime?
  nextVerificationDue       DateTime?
  lastMaintenanceAt         DateTime?
  nextMaintenanceDue        DateTime?
  status                    EquipmentStatus @default(IN_SERVICE)
  statusReason              String?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  process        Process           @relation(fields: [processId], references: [id])
  owner          User              @relation("EquipmentOwner", fields: [ownerId], references: [id])
  calibrations   Calibration[]
  verifications  Verification[]
  maintenances   Maintenance[]
  qualifications Qualification[]
  proficiency    ProficiencyTest[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

/// Calibración (interna o externa) con certificado, puntos medidos y decisión de conformidad.
model Calibration {
  id                   String             @id @default(cuid())
  organizationId       String
  code                 String
  equipmentId          String
  kind                 CalibrationKind
  provider             String?
  accreditation        String?
  certificateNumber    String?
  calibratedAt         DateTime
  /// Puntos medidos (array JSON): { nominal, reading, error, uncertainty, conform }.
  points               Json
  unit                 String?
  /// Patrones usados en una calibración interna (array JSON de ids de Equipment).
  referenceStandardIds Json?
  result               CalibrationResult
  computedResult       CalibrationResult?
  comments             String?
  impactAssessment     String?
  deviationId          String?
  fileName             String?
  fileMime             String?
  fileSize             Int?
  fileSha256           String?
  storageKey           String?
  status               RecordStatus       @default(RECORDED)
  recordedById         String
  approvedById         String?
  approvedAt           DateTime?
  rejectionReason      String?
  createdAt            DateTime           @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, equipmentId])
}

/// Verificación intermedia entre calibraciones.
model Verification {
  id             String             @id @default(cuid())
  organizationId String
  equipmentId    String
  performedAt    DateTime
  performedById  String
  method         String
  readings       String
  result         VerificationResult
  comments       String?
  createdAt      DateTime           @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([organizationId, equipmentId])
}

/// Mantenimiento preventivo o correctivo.
model Maintenance {
  id                    String          @id @default(cuid())
  organizationId        String
  equipmentId           String
  type                  MaintenanceType
  performedAt           DateTime
  performedBy           String
  description           String
  requiresRecalibration Boolean         @default(false)
  recordedById          String
  createdAt             DateTime        @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([organizationId, equipmentId])
}

/// Calificación DQ/IQ/OQ/PQ con protocolo, informe y aprobación de Garantía de Calidad.
model Qualification {
  id              String              @id @default(cuid())
  organizationId  String
  code            String
  equipmentId     String
  phase           QualificationPhase
  protocolRef     String
  executedAt      DateTime
  result          QualificationResult
  summary         String
  fileName        String?
  fileMime        String?
  fileSize        Int?
  fileSha256      String?
  storageKey      String?
  status          RecordStatus        @default(RECORDED)
  recordedById    String
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime            @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, equipmentId])
}

/// Ensayo de aptitud / comparación interlaboratorio (ISO/IEC 17025 §7.7.2, ISO 13528).
model ProficiencyTest {
  id             String             @id @default(cuid())
  organizationId String
  code           String
  provider       String
  scheme         String
  round          String
  measurand      String
  equipmentId    String?
  reportedValue  Float?
  assignedValue  Float?
  sigma          Float?
  zScore         Float
  outcome        ProficiencyOutcome
  reportDate     DateTime
  comments       String?
  recordedById   String
  createdAt      DateTime           @default(now())

  equipment Equipment? @relation(fields: [equipmentId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, reportDate])
}
