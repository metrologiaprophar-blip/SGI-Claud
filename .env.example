# Base de datos: "sqlite" (desarrollo rápido) o "postgresql"
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"
# Para PostgreSQL local (docker compose up -d db):
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://sgi:sgi@localhost:5432/sgi_cloud?schema=public"

# Auth.js — generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Textos de los indicadores del login (deben corresponder con la realidad)
NEXT_PUBLIC_AVAILABILITY_TEXT="99,5 %"

# Claves iniciales del seed (obligatorias si NODE_ENV=production)
SEED_ADMIN_PASSWORD=
SEED_SUPERADMIN_PASSWORD=
# true = los usuarios sembrados deben cambiar la clave al entrar
SEED_FORCE_PASSWORD_CHANGE=true

# Carpeta de archivos de documentos controlados (respaldar junto con la base de datos)
STORAGE_DIR=storage
